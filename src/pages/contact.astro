---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import ScrollReveal from "../components/ScrollReveal";
import { SITE } from "../config/site.mjs";
import { Icon } from "astro-icon/components";
---

<Layout
  title={`Contact | ${SITE.title}`}
  description="Get in touch with me. I'd love to hear from you about private tutoring or any questions you may have."
  canonicalURL={`${SITE.url}/contact`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-2xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold text-gray-900 mb-4">Contact</h1>
      </ScrollReveal>
      <ScrollReveal client:idle delay={0.1}>
        <p class="text-xl text-gray-600 mb-2">Get in touch with me. I'd love to hear from you.</p>
      </ScrollReveal>
      
      <!-- Desktop: fixed top-right bubble (outer container NOT animated) -->
      <div class="fixed top-20 right-4 z-50 p-0 bg-transparent hidden sm:block">
        <ScrollReveal client:load direction="up" distance={20} delay={0.1}>
          <div class="p-4 bg-white/90 backdrop-blur-sm border border-gray-100 rounded-lg shadow-md flex items-start gap-3 text-gray-700">
            <Icon name="tabler:phone" class="w-5 h-5 mt-1 text-gray-900" aria-hidden="true" />
            <p class="text-base">
              Prefer to reach out directly?<br />
              Call or text me at
              <a
                href="tel:+15146214989"
                class="font-semibold text-gray-900 hover:underline"
              >
                (514) 621-4989
              </a>.
              <span class="text-gray-500">Texting is usually fastest.</span>
            </p>
          </div>
        </ScrollReveal>
      </div>

      <!-- Mobile: centered bubble above the form (appears in flow) -->
      <div class="sm:hidden flex justify-center mb-4">
        <ScrollReveal client:idle direction="up" delay={0.15}>
          <div class="w-full max-w-md p-4 bg-white/95 backdrop-blur-sm border border-gray-100 rounded-lg shadow-md flex items-start gap-3 text-gray-700">
            <Icon name="tabler:phone" class="w-5 h-5 mt-1 text-gray-900" aria-hidden="true" />
            <p class="text-base">
              Prefer to reach out directly?<br />
              Call or text me at
              <a
                href="tel:+15146214989"
                class="font-semibold text-gray-900 hover:underline"
              >
                (514) 621-4989
              </a>.
              <span class="text-gray-500">Texting is usually fastest.</span>
            </p>
          </div>
        </ScrollReveal>
      </div>

      <ScrollReveal client:idle delay={0.2}>
        <ContactForm />
        <p class="text-sm text-gray-600 mt-3">would you like to leave a testimonial/feedback? <a href="/testimonials" class="underline font-medium">click here</a></p>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>

