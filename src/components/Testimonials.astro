---
import testimonials from "../data/testimonials.js";
import ScrollReveal from "./ScrollReveal";
// safe JSON serialization for client-side parsing (escape </script>)
const testimonialsJSON = JSON.stringify(testimonials).replace(/<\/script>/g, '<\\/script>');
---


<section class="max-w-6xl mx-auto px-4 py-20">
	<ScrollReveal client:load>
	<h2 class="text-3xl font-bold text-gray-900 mb-6">Testimonials</h2>
	</ScrollReveal>
    <ScrollReveal client:load delay={0.2}>
	<div class="relative overflow-hidden">
		<div class="testimonial-track" aria-hidden="true">
			<div class="testimonial-track-inner">
				<!-- cards will be injected here client-side to allow randomization on each load -->
			</div>
		</div>
	</div>
	</ScrollReveal>

	<!-- serialized testimonials for client-side rendering -->
	<script type="application/json" id="testimonials-data" set:html={testimonialsJSON}></script>

	<style>
		.testimonial-track {
			overflow: hidden;
		}

		.testimonial-track-inner {
			display: flex;
			gap: 1.5rem;
			padding: 0.5rem 0;
			animation: marquee var(--anim-duration, 25s) linear infinite;
		}

		/* pause animation when user hovers or focuses inside the track */
		.testimonial-track:hover .testimonial-track-inner,
		.testimonial-track:focus-within .testimonial-track-inner,
		.testimonial-track-inner:hover,
		.testimonial-track-inner:focus-within {
			animation-play-state: paused;
		}


		@keyframes marquee {
			from { transform: translateX(0); }
			to { transform: translateX(calc(-1 * var(--scroll-width))); }
		}

		/* ensure cards shrink nicely on small screens */
		@media (max-width: 1024px) {
			.testimonial-track-inner { animation-duration: 30s; }
		}

		@media (max-width: 640px) {
			.testimonial-track-inner { animation-duration: 35s; }
			article { min-width: 280px; }
		}
	</style>

	<script type="module">
		// client-side render + randomize testimonials, then setup marquee
		function shuffleArray(arr) {
			for (let i = arr.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[arr[i], arr[j]] = [arr[j], arr[i]];
			}
			return arr;
		}

		function buildCard(t) {
			const article = document.createElement('article');
			article.className = 'min-w-[360px] max-w-md bg-white border border-gray-100 rounded-lg p-8 shadow-sm';

			const p = document.createElement('p');
			p.className = 'text-gray-700 mb-6 leading-relaxed';
			p.textContent = `“${t.quote}”`;
			article.appendChild(p);

			const flex = document.createElement('div');
			flex.className = 'flex items-center gap-4';

			const avatar = document.createElement('div');
			avatar.className = 'w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-sm font-semibold text-gray-700';
			avatar.textContent = t.initials;
			flex.appendChild(avatar);

			const meta = document.createElement('div');
			const nameDiv = document.createElement('div');
			nameDiv.className = 'font-semibold text-gray-900';
			nameDiv.textContent = t.name;
			const courseDiv = document.createElement('div');
			courseDiv.className = 'text-sm text-gray-500';
			courseDiv.textContent = t.course;
			meta.appendChild(nameDiv);
			meta.appendChild(courseDiv);

			flex.appendChild(meta);
			article.appendChild(flex);

			return article;
		}

		function setupMarquee() {
			const inner = document.querySelector('.testimonial-track-inner');
			if (!inner) return;
			// total width of both sets
			const total = inner.scrollWidth;
			const single = total / 2 || total;
			inner.style.setProperty('--scroll-width', single + 'px');
			const speed = 80; // px per second
			const duration = Math.max(12, Math.round(single / speed));
			inner.style.setProperty('--anim-duration', duration + 's');
		}

		function init() {
			const dataEl = document.getElementById('testimonials-data');
			if (!dataEl) return;
			let list = [];
			try {
				list = JSON.parse(dataEl.textContent || '[]');
			} catch (e) {
				console.error('Invalid testimonials JSON', e);
				return;
			}

			// shuffle the list so order is different each load
			shuffleArray(list);

			// duplicate the shuffled list for seamless marquee
			const display = [...list, ...list];

			const inner = document.querySelector('.testimonial-track-inner');
			if (!inner) return;
			// clear any existing
			inner.innerHTML = '';

			for (const t of display) {
				inner.appendChild(buildCard(t));
			}

			// measure and start animation
			setupMarquee();

			// recalc on resize
			let resizeTimeout;
			window.addEventListener('resize', () => {
				clearTimeout(resizeTimeout);
				resizeTimeout = setTimeout(setupMarquee, 150);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
	</script>
</section>
