---
import ScrollReveal from "./ScrollReveal";
import { Icon } from "astro-icon/components";
import solidworksIcon from "../assets/solidworks.svg";
---

<section id="services" class="max-w-6xl mx-auto px-4 py-20">
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="text-4xl font-bold text-gray-900 text-center mb-12">What I Offer</h2>
  </ScrollReveal>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <a
        href="/services#tutoring"
        class="block p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow"
      >
        <div
          class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
        >
          <Icon name="tabler:book" class="w-6 h-6 text-gray-900" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Course Tutoring</h3>
        <p class="text-gray-600">
          One-on-one help with mechanical engineering courses.
        </p>
      </a>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.3} scale={true}>
      <a
        href="/services#exam-prep"
        class="block p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow"
      >
        <div
          class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
        >
        
          <Icon
            name="tabler:pencil"
            class="w-6 h-6 text-gray-900"
            aria-hidden="true"
          />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Exam Prep</h3>
        <p class="text-gray-600">
          Focused review sessions to prepare for midterms and finals.
        </p>
      </a>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.4} scale={true}>
      <a
        href="/services#3d-printing"
        class="block p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow"
      >
        <div
          class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
        >
          <Icon name="tabler:cube-3d-sphere" class="w-6 h-6 text-gray-900" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">3D Printing</h3>
        <p class="text-gray-600">
          3D printing services for prototypes, projects, and personal prints.
        </p>
      </a>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.5} scale={true}>
      <a
        href="/services#tutoring"
        class="block p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow"
      >
        <div
          class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
        >
          <Icon name="tabler:file" class="w-6 h-6 text-gray-900" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Assignments</h3>
        <p class="text-gray-600">
          Help understanding assignments, tricky problems, and how to approach them.
        </p>
      </a>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.6} scale={true}>
      <a
        href="/services#cad-help"
        class="block p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow"
      >
        <div
          class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
        >
          <img src={solidworksIcon.src} alt="" aria-hidden="true" class="w-6 h-6 object-contain" />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">CAD help</h3>
        <p class="text-gray-600">
          Support with SolidWorks, assemblies, and design questions.
        </p>
      </a>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.7} scale={true}>
      <a
        href="/contact"
        class="block p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow"
      >
        <div
          class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4"
        >
          <Icon name="tabler:icons" class="w-6 h-6 text-gray-900" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Not sure where to start?</h3>
        <p class="text-gray-600">
          If you're unsure where to start, send a message and we'll figure it out.
        </p>
      </a>
    </ScrollReveal>
  </div>
</section>
