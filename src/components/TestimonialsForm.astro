---
import { SITE } from "../config/site.mjs";

// Web3Forms integration
// If SITE.web3formsAccessKey is not set, fall back to the provided key
const web3formsAccessKey = SITE.web3fromsAccessKeyTestimonials || "";
---

<form
  id="testimonial-form"
  class="space-y-6"
  aria-label="Testimonial submission form"
  novalidate
  action="https://api.web3forms.com/submit"
  method="POST"
>
  {web3formsAccessKey && (
    <input type="hidden" name="access_key" value={web3formsAccessKey} />
  )}

  <!-- Duplicate name into a plain `name` field so exports include it -->
  <input type="hidden" id="t-hidden-name" name="name" value="" />

  <input type="hidden" name="subject" value="New Testimonial Submission" />
  <input type="hidden" name="redirect" value="false" />

  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

  <div
    id="success-message-testimonial"
    class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-green-800"
    role="alert"
    aria-live="polite"
  >
    <p class="font-medium">Thank you for your testimonial!</p>
    <p class="text-sm mt-1">It will be reviewed and published shortly.</p>
  </div>

  <div
    id="error-message-testimonial"
    class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-red-800"
    role="alert"
    aria-live="assertive"
  >
    <p class="font-medium" id="error-text-testimonial"></p>
  </div>

  <!-- Name -->
  <div>
    <label for="t-name" class="block text-sm font-medium text-gray-700 mb-2">
      Name <span class="text-red-600" aria-label="required">*</span>
    </label>
    <input
      type="text"
      id="t-name"
      name="from_name"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-black focus:border-black outline-none transition-colors"
      required
      aria-required="true"
      aria-describedby="t-name-error"
      autocomplete="name"
    />
    <span id="t-name-error" class="mt-1 text-sm text-red-600 hidden" role="alert" aria-live="polite"></span>
  </div>

  <!-- Initials + Course on one line -->
  <div class="flex items-start gap-4">
    <div class="w-24">
      <label for="t-initials" class="block text-sm font-medium text-gray-700 mb-2">
        Initials <span class="text-red-600" aria-label="required">*</span>
      </label>
      <input
        type="text"
        id="t-initials"
        name="initials"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-black focus:border-black outline-none transition-colors"
        required
        aria-required="true"
        aria-describedby="t-initials-error"
        maxlength="3"
      />
      <span id="t-initials-error" class="mt-1 text-sm text-red-600 hidden" role="alert" aria-live="polite"></span>
    </div>

    <div class="w-30 shrink-0">
      <label for="t-course" class="block text-sm font-medium text-gray-700 mb-2">
        Course <span class="text-red-600" aria-label="required">*</span>
      </label>
      <div>
        <input
          type="text"
          id="t-course"
          name="course"
          class="w-full min-w-0 px-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-black focus:border-black outline-none transition-colors"
          required
          aria-required="true"
          aria-describedby="t-course-error"
          maxlength="8"
          minlength="8"
          pattern="[A-Za-z]{4} [0-9]{3}"
        />
        <span id="t-course-error" class="mt-1 block text-sm text-red-600 hidden" role="alert" aria-live="polite"></span>
      </div>
    </div>
  </div>

  <!-- Quote -->
  <div>
    <label for="t-quote" class="block text-sm font-medium text-gray-700 mb-2">
    Quote <span class="text-red-600" aria-label="required">*</span>
    </label>
    <div class="relative">
      <textarea
        id="t-quote"
        name="quote"
        rows="6"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-black focus:border-black outline-none transition-colors resize-none"
        required
        aria-required="true"
        aria-describedby="t-quote-error t-quote-count"
        maxlength="300"
      ></textarea>
      <span id="t-quote-count" class="absolute bottom-2 right-3 text-sm text-gray-500">0/300</span>
    </div>
    <span id="t-quote-error" class="mt-1 text-sm text-red-600 hidden" role="alert" aria-live="polite"></span>
  </div>

  <button
    type="submit"
    id="t-submit-button"
    class="w-full px-6 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black disabled:opacity-50 disabled:cursor-not-allowed"
  >
    <span id="t-submit-text">Submit Testimonial</span>
    <span id="t-submit-loading" class="hidden">Sending...</span>
  </button>
</form>

<script>
  const form = document.getElementById("testimonial-form") as HTMLFormElement;
  const submitButton = document.getElementById("t-submit-button") as HTMLButtonElement;
  const submitText = document.getElementById("t-submit-text") as HTMLSpanElement;
  const submitLoading = document.getElementById("t-submit-loading") as HTMLSpanElement;
  const successMessage = document.getElementById("success-message-testimonial") as HTMLDivElement;
  const errorMessage = document.getElementById("error-message-testimonial") as HTMLDivElement;
  const errorText = document.getElementById("error-text-testimonial") as HTMLParagraphElement;

  const nameInput = document.getElementById("t-name") as HTMLInputElement;
  const initialsInput = document.getElementById("t-initials") as HTMLInputElement;
  const courseInput = document.getElementById("t-course") as HTMLInputElement;
  const quoteInput = document.getElementById("t-quote") as HTMLTextAreaElement;

  const nameError = document.getElementById("t-name-error") as HTMLSpanElement;
  const initialsError = document.getElementById("t-initials-error") as HTMLSpanElement;
  const courseError = document.getElementById("t-course-error") as HTMLSpanElement;
  const quoteError = document.getElementById("t-quote-error") as HTMLSpanElement;
  const QUOTE_MAX = 300;
  const quoteCount = document.getElementById("t-quote-count") as HTMLSpanElement;
  const hiddenName = document.getElementById("t-hidden-name") as HTMLInputElement;

  function updateQuoteCount() {
    // enforce cap (handles paste)
    if (quoteInput.value.length > QUOTE_MAX) {
      quoteInput.value = quoteInput.value.slice(0, QUOTE_MAX);
    }
    const len = quoteInput.value.length;
    if (quoteCount) quoteCount.textContent = `${len}/${QUOTE_MAX}`;
  }

  // update counter while typing / on load
  quoteInput.addEventListener("input", updateQuoteCount);
  updateQuoteCount();

  // keep hidden name field in sync so exports include a `name` column
  function syncHiddenName() {
    if (hiddenName) hiddenName.value = nameInput.value.trim();
  }
  nameInput.addEventListener("input", syncHiddenName);
  syncHiddenName();

  function showFieldError(field, errorElement, message) {
    field.setAttribute("aria-invalid", "true");
    field.classList.add("border-red-500");
    errorElement.textContent = message;
    errorElement.classList.remove("hidden");
  }

  function clearFieldError(field, errorElement) {
    field.setAttribute("aria-invalid", "false");
    field.classList.remove("border-red-500");
    errorElement.classList.add("hidden");
    errorElement.textContent = "";
  }

  function hideAllMessages() {
    successMessage.classList.add("hidden");
    errorMessage.classList.add("hidden");
  }

  function setLoading(loading) {
    submitButton.disabled = loading;
    if (loading) {
      submitText.classList.add("hidden");
      submitLoading.classList.remove("hidden");
    } else {
      submitText.classList.remove("hidden");
      submitLoading.classList.add("hidden");
    }
  }

  initialsInput.addEventListener("blur", () => {
    const v = initialsInput.value.trim();
    if (!v) {
      showFieldError(initialsInput, initialsError, "Initials are required");
    } else if (v.length < 2) {
      showFieldError(initialsInput, initialsError, "Initials must be at least 2 characters");
    } else {
      clearFieldError(initialsInput, initialsError);
    }
  });

  nameInput.addEventListener("blur", () => {
    const v = nameInput.value.trim();
    if (!v) {
      showFieldError(nameInput, nameError, "Name is required");
    } else if (v.length < 2) {
      showFieldError(nameInput, nameError, "Name must be at least 2 characters");
    } else {
      clearFieldError(nameInput, nameError);
    }
  });

  courseInput.addEventListener("blur", () => {
    const v = courseInput.value.trim();
    const pattern = /^[A-Za-z]{4} [0-9]{3}$/;
    if (!v) {
      showFieldError(courseInput, courseError, "Course is required");
    } else if (!pattern.test(v)) {
      showFieldError(courseInput, courseError, "Course must be in format ABCD 123 (with the space)");
    } else {
      clearFieldError(courseInput, courseError);
    }
  });

  quoteInput.addEventListener("blur", () => {
    const v = quoteInput.value.trim();
    if (!v) {
      showFieldError(quoteInput, quoteError, "Testimonial is required");
    } else if (v.length < 10) {
      showFieldError(quoteInput, quoteError, "Testimonial must be at least 10 characters");
    } else {
      clearFieldError(quoteInput, quoteError);
    }
  });

  const accessKeyInput = form.querySelector('input[name="access_key"]') as HTMLInputElement;
  const hasAccessKey = accessKeyInput && accessKeyInput.value.trim() !== "";

  if (!hasAccessKey) {
    const warningDiv = document.createElement("div");
    warningDiv.className = "p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-yellow-800 text-sm";
    warningDiv.innerHTML = `
      <p class="font-medium mb-1">⚠️ Web3Forms not configured</p>
      <p>Please add your Web3Forms access key to <code class="bg-yellow-100 px-1 rounded">src/config/site.mjs</code>. Get your key from <a href="https://web3forms.com" target="_blank" rel="noopener noreferrer" class="underline">web3forms.com</a></p>
    `;
    form.insertBefore(warningDiv, form.firstChild);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideAllMessages();

    if (!hasAccessKey) {
      errorText.textContent = "Form is not configured. Please contact the site administrator.";
      errorMessage.classList.remove("hidden");
      errorMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
      return;
    }

    clearFieldError(nameInput, nameError);
    clearFieldError(initialsInput, initialsError);
    clearFieldError(courseInput, courseError);
    clearFieldError(quoteInput, quoteError);

    let isValid = true;

    if (!nameInput.value.trim()) {
      showFieldError(nameInput, nameError, "Name is required");
      isValid = false;
    }

    const initialsVal = initialsInput.value.trim();
    if (!initialsVal) {
      showFieldError(initialsInput, initialsError, "Initials are required");
      isValid = false;
    } else if (initialsVal.length < 2) {
      showFieldError(initialsInput, initialsError, "Initials must be at least 2 characters");
      isValid = false;
    }

    const courseVal = courseInput.value.trim();
    const coursePattern = /^[A-Za-z]{4} [0-9]{3}$/;
    if (!courseVal) {
      showFieldError(courseInput, courseError, "Course is required");
      isValid = false;
    } else if (!coursePattern.test(courseVal)) {
      showFieldError(courseInput, courseError, "Course must be in format ABCD 123 (with the space)");
      isValid = false;
    }

    if (!quoteInput.value.trim()) {
      showFieldError(quoteInput, quoteError, "Testimonial is required");
      isValid = false;
    } else if (quoteInput.value.trim().length < 10) {
      showFieldError(quoteInput, quoteError, "Testimonial must be at least 10 characters");
      isValid = false;
    }

    if (!isValid) {
      const firstError = form.querySelector('[aria-invalid="true"]') as HTMLElement;
      if (firstError) firstError.focus();
      return;
    }

    setLoading(true);

    try {
      const formData = new FormData(form);

      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (response.ok && data.success) {
        successMessage.classList.remove("hidden");
        form.reset();
        successMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } else {
        errorText.textContent = data.message || "Failed to send testimonial. Please try again.";
        errorMessage.classList.remove("hidden");
        errorMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    } catch (err) {
      errorText.textContent = "Network error. Please check your connection and try again.";
      errorMessage.classList.remove("hidden");
      errorMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } finally {
      setLoading(false);
    }
  });
</script>
