---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-12 px-4 border-t border-gray-200 bg-white"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Office Hours</h2>
        <p class="text-gray-600">
          A website I whipped up for a little private tutoring business.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Links</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/services"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Services</a
            >
          </li>
          <li>
            <a
              href="/about"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >About</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Contact</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Connect</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://discord.gg/u5DA3uWdse"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Join my Discord (opens in new tab)"
            >
              <Icon name="tabler:brand-discord" class="w-5 h-5" aria-hidden="true" />
              <span>Discord</span></a
            >
          </li>
          <li>
            <a
              href="https://wa.me/15146214989"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Chat with me on WhatsApp (opens in new tab)"
            >
              <Icon name="tabler:brand-whatsapp" class="w-5 h-5" aria-hidden="true" />
              <span>WhatsApp</span></a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:mail" class="w-5 h-5" aria-hidden="true" />
              <span>Email</span></a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-gray-200 text-center text-gray-600">
      <p>&copy; {new Date().getFullYear()} Office Hours. All rights reserved.</p>
    </div>
  </div>
</footer>
