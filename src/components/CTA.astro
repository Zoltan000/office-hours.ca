---
import ScrollReveal from "./ScrollReveal";
import { Icon } from "astro-icon/components";
---

<section id="about" class="max-w-6xl mx-auto px-4 py-20">
  <ScrollReveal client:idle scale={true}>
    <div class="bg-black rounded-2xl p-12 text-center text-white">
      <h2 class="text-4xl font-bold mb-4">Feeling unsure?</h2>
      <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        If you're feeling unsure about private tutoring, why don't you check out my notes from MECH 368? My drive has the recordings
         for all the tutorials, as well as notes and falstad circuit simulations, all completely free.
      </p>
      <a
        href="https://drive.zoltanh.ca/s/MECH368Tutorials"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-3 bg-white text-black rounded-lg hover:bg-gray-100 transition-colors font-medium"
      >
        <Icon name="tabler:cloud" class="w-5 h-5" aria-hidden="true" />
        My Drive
      </a>
    </div>
  </ScrollReveal>
</section>
