---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TestimonialsForm from "../components/TestimonialsForm.astro";
import ScrollReveal from "../components/ScrollReveal";
import { SITE } from "../config/site.mjs";
import { Icon } from "astro-icon/components";
---

<Layout
  title={`Testimonial Submission | ${SITE.title}`}
  description="I'd love to hear from you about your experience or feedback."
  canonicalURL={`${SITE.url}/testimonials`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-2xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold text-gray-900 mb-4">Submit a Testimonial</h1>
      </ScrollReveal>
      <ScrollReveal client:idle delay={0.2}>
        <p class="text-xl text-gray-600 mb-2">I'd love it if you could share your experience or feedback.</p>
      </ScrollReveal>
 
