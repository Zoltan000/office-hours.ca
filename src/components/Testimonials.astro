---
import testimonials from "../data/testimonials.js";
---


<section class="max-w-6xl mx-auto px-4 py-20">
  <h2 class="text-3xl font-bold text-gray-900 mb-6">Testimonials</h2>

  <div class="relative overflow-hidden">
		<div class="testimonial-track" aria-hidden="true">
			<div class="testimonial-track-inner">
				{
					// duplicate the array inline so the track can scroll seamlessly
					[...testimonials, ...testimonials].map((t, i) => (
						<article class="min-w-[360px] max-w-md bg-white border border-gray-100 rounded-lg p-8 shadow-sm">
							<p class="text-gray-700 mb-6 leading-relaxed">“{t.quote}”</p>
							<div class="flex items-center gap-4">
								<div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-sm font-semibold text-gray-700">
									{t.initials}
								</div>
								<div>
									<div class="font-semibold text-gray-900">{t.name}</div>
									<div class="text-sm text-gray-500">{t.course}</div>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
  </div>

	<style>
		.testimonial-track {
			overflow: hidden;
		}

		.testimonial-track-inner {
			display: flex;
			gap: 1.5rem;
			padding: 0.5rem 0;
			animation: marquee var(--anim-duration, 25s) linear infinite;
		}

		/* pause animation when user hovers or focuses inside the track */
		.testimonial-track:hover .testimonial-track-inner,
		.testimonial-track:focus-within .testimonial-track-inner,
		.testimonial-track-inner:hover,
		.testimonial-track-inner:focus-within {
			animation-play-state: paused;
		}


		@keyframes marquee {
			from { transform: translateX(0); }
			to { transform: translateX(calc(-1 * var(--scroll-width))); }
		}

		/* ensure cards shrink nicely on small screens */
		@media (max-width: 1024px) {
			.testimonial-track-inner { animation-duration: 30s; }
		}

		@media (max-width: 640px) {
			.testimonial-track-inner { animation-duration: 35s; }
			article { min-width: 280px; }
		}
	</style>

	<script type="module">
		// Measure the single set width and set CSS variables for smooth animation
		function setupMarquee() {
			const inner = document.querySelector('.testimonial-track-inner');
			if (!inner) return;
			// total width of both sets
			const total = inner.scrollWidth;
			const single = total / 2;
			// set --scroll-width to the pixel width of one set
			inner.style.setProperty('--scroll-width', single + 'px');
			// derive duration so speed is reasonable (px per second)
			const speed = 80; // px per second
			const duration = Math.max(12, Math.round(single / speed));
			inner.style.setProperty('--anim-duration', duration + 's');
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupMarquee);
		} else {
			setupMarquee();
		}

		// Recalculate on resize to handle responsive layout
		let resizeTimeout;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(setupMarquee, 150);
		});
	</script>
</section>
