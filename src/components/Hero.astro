---
import ScrollReveal from "./ScrollReveal";
import { Icon } from "astro-icon/components";
import background from '../assets/background.svg';
---

<img id="background" src={background.src} alt="" fetchpriority="high" />

<section class="max-w-6xl mx-auto px-4 py-20 md:py-32 text-center" aria-labelledby="hero-heading">
  <ScrollReveal client:load>
    <h1 id="hero-heading" class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
      Office Hours
    </h1>
  </ScrollReveal>
  <ScrollReveal client:load delay={0.2}>
    <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-5xl mx-auto">
      My own office hours — one-on-one help for mech courses, CAD, exam prep, and 3D printing.
    </p>
  </ScrollReveal>
  <ScrollReveal client:load delay={0.3}>
    <p class="text-lg text-gray-500 mb-12 max-w-4xl mx-auto">
      Private tutoring for Concordia mechanical engineering students.
    </p>
  </ScrollReveal>
  <!-- <ScrollReveal client:load delay={0.4}>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/contact"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium"
        aria-label="Contact Zoltan via email (opens in new tab)"
      >
        <Icon name="tabler:mail" class="w-5 h-5" aria-hidden="true" />
        <span>Contact</span>
      </a>
      <a
        href="/about"
        class="inline-block px-8 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors font-medium"
      >
        Learn More
      </a>
    </div>
  </ScrollReveal> -->
</section>

<style>
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }
</style>
