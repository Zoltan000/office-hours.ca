---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`About | ${SITE.title}`}
  description="Learn more about Astro Base - a minimal, modern starter template for building fast websites with Astro, React, Tailwind CSS, and Framer Motion."
  canonicalURL={`${SITE.url}/about`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-5xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold text-gray-900 mb-8">About Me</h1>
      </ScrollReveal>

      <div class="max-w-3xl">
      <ScrollReveal client:load delay={0.1}>
        <p class="text-xl text-gray-600 mb-5 leading-relaxed">
          My name is Zoltan Hegyi and I'm a mechanical engineering student just like you, currently in my fourth year at Concordia.
          I've been a teaching assistant for MECH 368 and MIAE 312 for over two years, helping students in tutorials, labs, and outside of class.
        </p>
        <p class="text-xl text-gray-600 mb-0 leading-relaxed">
          I really love what I do, and I think it's because I get immense satisfaction from helping students understand difficult concepts and succeed in their courses.
          Over the years, I've gone above and beyond to help students both inside and out of class, and I want to continue doing that through private tutoring.
        </p>
      </ScrollReveal>
      </div>

      <ScrollReveal client:load delay={0.15}>
        <div class="max-w-3xl mt-8 mb-14 p-5 border border-gray-200 rounded-lg bg-gray-50/60">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-indigo-700 mb-3">Highlights</h2>
          <ul class="list-disc pl-5 space-y-2 text-gray-700">
            <li>Teaching Assistant for MECH 368 and MIAE 312 (2+ years)</li>
            <li>Nominated for Concordia’s Award for Teaching Excellence</li>
          </ul>
        </div>
      </ScrollReveal>

      <div class="max-w-4xl space-y-10">
        <ScrollReveal client:load delay={0.2}>
          <h2 class="text-3xl font-bold text-indigo-700 mb-8">My Expertise</h2>

          <div class="space-y-8">
            <section>
              <h3 class="text-xl font-semibold text-indigo-700 mb-2">MECH 368 — Electronics for Mechanical Engineers</h3>
              <p class="text-gray-700 mb-3 leading-relaxed">
                I can confidently say, this is by far my strongest course. 
                I've solved countless quizzes and assignments, and even designed several term projects for fun.
              </p>
              <ul class="list-disc pl-5 space-y-2 text-gray-700">
                <li>Additional practice problems not available on Moodle</li>
                <li>Material from previous semesters, including Collaborative Quizzes</li>
                <li>Physical components for circuit practice, including a small oscilloscope</li>
              </ul>
            </section>

            <section>
              <h3 class="text-xl font-semibold text-indigo-700 mb-2">MIAE 312 — Engineering Design and Manufacturing Processes Lab</h3>
              <p class="text-gray-700 mb-3 leading-relaxed">
                After grading hundreds of lab reports for MIAE 312 over multiple semesters,
                I've seen just about every mistake students tend to make. Because of that
                experience, the following courses also fall within my area of expertise:
              </p>
              <ul class="list-disc pl-5 space-y-2 text-gray-700">
                <li><strong>MIAE 311</strong> - Manufacturing Processes</li>
                <li><strong>MIAE 313</strong> - Machine Drawing and Design</li>
                <li><strong>MECH 343</strong> - Theory of Machines</li>
              </ul>
            </section>

            <section>
              <h3 class="text-xl font-semibold text-indigo-700 mb-2">CAD and 3D Printing Service</h3>
              <p class="text-gray-700 leading-relaxed">
                I have extensive experience with CAD software and 3D printing, and can help with both designing parts and producing them.
                Whether you need help preparing a model for manufacturing or printing a finished design, I can guide you through the process.
              </p>
              <ul class="list-disc pl-5 space-y-2 text-gray-700">
                <li>Strong experience with <strong>SolidWorks</strong> and <strong>Fusion 360</strong> for part design and model preparation</li>
                <li>Parts printed on a <strong>Bambu Lab X1C with AMS</strong>, allowing reliable prints and multi-material or multi-color capability</li>
                <li>Logged <strong>650+ hours of print time</strong>, with practical experience troubleshooting prints and optimizing models for successful results</li>
              </ul>
            </section>
          </div>
        </ScrollReveal>
