---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`About | ${SITE.title}`}
  description="Learn more about Astro Base - a minimal, modern starter template for building fast websites with Astro, React, Tailwind CSS, and Framer Motion."
  canonicalURL={`${SITE.url}/about`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-4xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold text-gray-900 mb-6">Office Hours</h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.1}>
        <p class="text-xl text-gray-600 mb-4">
          My name is Zoltan Hegyi and I'm a bachelors student just like you, currently in my fourth-year studying mechanical engineering at Concordia.
          I have been a teaching assistant for two courses for over two years helping students in tutorials, labs, and outside of class.
        </p>
        <p class="text-xl text-gray-600 mb-4">
          I really love what I do, and I think it's because I get immense satisfaction from helping students understand difficult concepts and succeed in their courses.
          Over the years, I've gone above and beyond to help students both inside and out of class, and I want to continue doing that through private tutoring.
        </p>
        <p class="text-xl text-gray-600 mb-12">
          
        </p>
      </ScrollReveal>

      <div class="prose prose-lg max-w-none">
        <ScrollReveal client:load delay={0.2}>
          <h2>What I Offer</h2>
          <ul>
            <li>
              <strong>MECH 368</strong> - Electronics for Mechanical Engineers
              <ul> 
              <li>I have a boatload of practice problems not available on moodle</li>
              <li>Material from previous semesters like Collaborative Quizzes</li> 
              <li>A ton of physical components we can use to practice building circuits (including a small oscilloscope)</li> 
              </ul>
            </li>
            <li>
              <strong>MIAE 312</strong> - Engineering Design and Manufacturing Processes Lab
            </li>
            <li>
              <strong>CAD and 3D Printing Service</strong> - I have a ton of experience with CAD software (SolidWorks, Fusion 360) and 3D printing. I can help you with your CAD projects or print your designs for you.
            </li>
          </ul>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.4}>
          <h2>Getting Started</h2>
          <h3>Installation</h3>
          <ol>
            <li>
              <strong>Clone the repository</strong>
              <pre><code>git clone https://github.com/jonnysmillie/astro-base.git
cd astro-base</code></pre>
            </li>
            <li>
              <strong>Install dependencies</strong>
              <pre><code>npm install</code></pre>
            </li>
            <li>
              <strong>Start the development server</strong>
              <pre><code>npm run dev</code></pre>
            </li>
            <li>
              <strong>Open your browser</strong> - Navigate to <code
                >http://localhost:4321</code
              >
            </li>
          </ol>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.5}>
          <h2>Available Scripts</h2>
          <ul>
            <li><code>npm install</code> - Installs dependencies</li>
            <li>
              <code>npm run dev</code> - Starts local dev server at <code
                >localhost:4321</code
              >
            </li>
            <li>
              <code>npm run build</code> - Build your production site to <code
                >./dist/</code
              >
            </li>
            <li><code>npm run preview</code> - Preview your build locally</li>
            <li>
              <code>npm run astro</code> - Run CLI commands like <code
                >astro add</code
              >, <code>astro check</code>
            </li>
          </ul>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.6}>
          <h2>Styling</h2>

          <h3>Tailwind CSS</h3>
          <p>
            This project uses Tailwind CSS v4 for styling. All components use
            Tailwind utility classes.
          </p>

          <p><strong>Global Styles:</strong></p>
          <ul>
            <li>Located in <code>src/styles/global.css</code></li>
            <li>Imports Tailwind CSS</li>
            <li>Includes Tailwind Typography plugin for markdown styling</li>
          </ul>

          <p><strong>Configuration:</strong></p>
          <ul>
            <li>
              <code>tailwind.config.mjs</code> - Tailwind configuration with Typography
              plugin
            </li>
          </ul>

          <h3>Sass</h3>
          <p>
            Sass is installed and ready to use. You can use Sass in component <code
              >&lt;style&gt;</code
            > blocks. See <code>src/components/SassExample.astro</code> for a complete
            example.
          </p>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.7}>
          <h2>Components</h2>

          <h3>ScrollReveal</h3>
          <p>
            A React component using Framer Motion for scroll-triggered
            animations with the following props:
          </p>
          <ul>
            <li>
              <code>delay</code> - Animation delay in seconds (default: 0)
            </li>
            <li>
              <code>direction</code> - Animation direction: "up" | "down" | "left"
              | "right" (default: "up")
            </li>
            <li>
              <code>distance</code> - Distance to travel in pixels (default: 50)
            </li>
            <li>
              <code>scale</code> - Enable scale animation (default: false)
            </li>
          </ul>

          <h3>Icons</h3>
          <p>
            Use Tabler icons with astro-icon. Browse available icons at <a
              href="https://tabler.io/icons"
              target="_blank"
              rel="noopener noreferrer">Tabler Icons</a
            >.
          </p>
        </ScrollReveal>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
